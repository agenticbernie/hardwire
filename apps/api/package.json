{
  "name": "@hardwire/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24 <25" },
  "scripts": {
    "start": "node --experimental-strip-types src/server.ts",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "npm run typecheck",
    "dev:worker": "wrangler dev --config wrangler.jsonc --persist-to ../../.wrangler",
    "deploy:worker": "wrangler deploy --config wrangler.jsonc"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@hardwire/contracts": "0.1.0",
    "fastify": "^5.6.2",
    "zod": "^4.0.0"
  }
}
