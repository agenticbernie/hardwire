{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "hardwire-app",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-17",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "vars": {
    "PUBLIC_ORIGIN": "https://hardwire-app.bernie-web3.workers.dev",
    "DATA_WORKER_URL": "https://hardwire-data.bernie-web3.workers.dev",
    "GITHUB_OWNER": "agenticbernie",
    "GITHUB_REPO": "hardwire",
    "GITHUB_WORKFLOW": "hardwire-poc.yml",
    "GITHUB_REF": "main"
  },
  "d1_databases": [{
    "binding": "AUTH_DB",
    "database_name": "hardwire",
    "database_id": "08adc5cc-150e-4365-a9d9-239d52cdcf00"
  }],
  "services": [{
    "binding": "DATA_SERVICE",
    "service": "hardwire-data"
  }],
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*", "/healthz"]
  }
}
